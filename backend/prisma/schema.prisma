generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id           String        @id @default(uuid())
  name         String
  summary      String
  skills       String[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]
  education    Education[]
  experiences  Experience[]
  jobs         Job[]
  projects     Project[]
}

model Experience {
  id            String      @id @default(uuid())
  company       String
  title         String
  description   String
  startDate     DateTime
  endDate       DateTime?
  userProfileId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model Education {
  id            String      @id @default(uuid())
  school        String
  degree        String
  field         String
  userProfileId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model Project {
  id            String      @id @default(uuid())
  name          String
  description   String
  technologies  String[]
  userProfileId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model Job {
  id            String        @id @default(uuid())
  title         String
  company       String
  description   String
  url           String?
  coverLetter String?
  userProfileId String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  applications  Application[]
  userProfile   UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}

model Application {
  id            String      @id @default(uuid())
  status        String
  notes         String?
  jobId         String
  userProfileId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  job           Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
}
